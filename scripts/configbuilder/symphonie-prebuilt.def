Bootstrap: yum
OSVERSION: 8
MirrorURL: http://10.120.116.5/repositories//redhat/8.8/$basearch/os/BaseOS
Include: yum which time tar gzip bzip2 gawk findutils perl-interpreter make libnl3 numactl-libs libsysfs hostname tcl freeipmi jansson libsysfs gdk-pixbuf2 hwloc-libs libnl3-devel pciutils pciutils-libs

%setup
    mkdir -p $SINGULARITY_ROOTFS/work/softs/rh8/spack_install/linux-rhel8-x86_64/gcc-8.5.0/intel-oneapi-compilers-2021.3.0-po2unejzdcprr7unoes754heiqovvwbw/
    mkdir -p $SINGULARITY_ROOTFS/work/softs/rh8/spack_install_20/linux-rhel8-x86_64/gcc-8.5.0/intel-oneapi-mpi-2021.10.0-a4vpkrrwo5bemjm5tfa2d57c4u6pbky7/
    mkdir -p $SINGULARITY_ROOTFS/usr/share/Modules/
    mkdir -p $SINGULARITY_ROOTFS/softs/tgz/

%files
    /softs/archives/REPO_RH8/etc/yum.repos.d /etc
    /softs/archives/REPO_RH8/etc/rhsm/ca /etc/rhsm
    /softs/archives/REPO_RH8/etc/pki/rpm-gpg/ /etc/pki 
    /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /softs/tgz/tls-ca-bundle.pem  
    /usr/lib64/libpmi.so 
    /tmp/cmake-v3.31.8.zip /softs/tgz/cmake-v3.31.8.zip

