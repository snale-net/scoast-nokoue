    export PATH=/work/softs/rh8/spack_install_20/linux-rhel8-x86_64/gcc-8.5.0/intel-oneapi-mpi-2021.10.0-a4vpkrrwo5bemjm5tfa2d57c4u6pbky7/mpi/2021.10.0//libfabric/bin:$PATH
    export INTEL_ONEAPI_MPIHOME=/work/softs/rh8/spack_install_20/linux-rhel8-x86_64/gcc-8.5.0/intel-oneapi-mpi-2021.10.0-a4vpkrrwo5bemjm5tfa2d57c4u6pbky7
    export I_MPI_PMI_LIBRARY=/usr/lib64/libpmi.so
    export FI_PROVIDER=MLX
    export I_MPI_ROOT=/work/softs/rh8/spack_install_20/linux-rhel8-x86_64/gcc-8.5.0/intel-oneapi-mpi-2021.10.0-a4vpkrrwo5bemjm5tfa2d57c4u6pbky7/mpi/2021.10.0

    # Create directories
    mkdir -p /softs
    mkdir -p /build      
    cd /build

    # Update system
    yum update -y
    
    # Install system packages
    yum install -y --allowerasing \
       gcc gcc-c++ gcc-gfortran glibc-devel kernel-headers libibverbs librdmacm libxpmem rdma-core rdma-core-devel pmix-devel autoconf pkg-config diffutils \
       unzip git wget bzip2 openssl-devel  \
       bc tcl procps-ng libxml2-devel curl-devel  \
    && yum clean all && rm -rf /var/cache/yum 
 

    # Load modules
    source /usr/share/Modules/init/bash
    mkdir /build/modules
    module use --append /build/modules

      # Update SSL
    cat >> ~/.wgetrc <<'EOF'
ca_certificate = /softs/tgz/tls-ca-bundle.pem
EOF

    # Install UCX and SYMPHONIE dependencies
    wget https://github.com/snale-net/pagure/archive/refs/heads/update/petsc.zip && \
    unzip petsc.zip && \
    cd pagure-update-petsc && \
    ./pagure.sh --prefix=/softs --module-dir=/build/modules --mode=docker install ucx==1.16.0 && \
    ./pagure.sh --prefix=/softs --module-dir=/build/modules --compiler=intel --mpi=intelmpi --mode=docker install SYMPHONIE
  
    # Clean up
    cd / 
    rm -rf /build
    rm -rf /softs/cmake
    yum remove -y --allowerasing \
	autoconf diffutils \
	unzip bzip2 git wget \
    bc tcl procps-ng \
	&& dnf clean all && rm -rf /var/cache/yum 

